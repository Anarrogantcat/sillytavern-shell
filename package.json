{
  "name": "sillytavern-electron",
  "version": "2.2.45",
  "description": "SillyTavern Desktop Shell — Electron wrapper with tray, terminal, auto-update",
  "license": "AGPL-3.0",
  "author": "小肥鱼 (DeepSeek V4 Flash) & 染喵",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "ui:check": "electron scripts/ui-snapshot.mjs",
    "st-prep": "node scripts/prebuild.js",
    "prebuild": "node scripts/ext-index.mjs",
    "prebuild:full": "node scripts/ext-index.mjs",
    "prebuild:lite": "node scripts/ext-index.mjs",
    "clean": "node scripts/clean-build.mjs",
    "build:full": "npm run clean -- full && npm run st-prep && electron-builder --win nsis --config.directories.output='dist-electron-v3'",
    "build:lite": "npm run clean -- lite && electron-builder --win nsis --config electron-builder-lite.json --config.directories.output='dist-electron-v3-lite'",
    "build:portable": "electron-builder --win zip --config electron-builder-lite.json --config.directories.output='dist-electron-v3-lite'",
    "ext:index": "node scripts/ext-index.mjs",
    "ext:install": "node scripts/ext-install.mjs",
    "ext:test": "node scripts/compat-logic-test.mjs && node scripts/plot-pilot-test.mjs && node scripts/ext-manage-test.mjs",
    "ext:manage:test": "node scripts/ext-manage-test.mjs",
    "cf:test": "node scripts/cf-download-test.mjs",
    "all:test": "node scripts/compat-logic-test.mjs && node scripts/ext-deploy-test.mjs && node scripts/ext-remote-test.mjs && node scripts/ext-manage-test.mjs && node scripts/cf-download-test.mjs && node scripts/plot-pilot-test.mjs && node scripts/toolbox-test.mjs",
    "ext:deploy:test": "node scripts/ext-deploy-test.mjs",
    "ext:remote:test": "node scripts/ext-remote-test.mjs",
    "toolbox:test": "node scripts/toolbox-test.mjs",
    "build": "npm run build:full"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "yargs": "^17.7.2"
  },
  "build": {
    "appId": "com.sillytavern.desktop",
    "productName": "SillyTavern",
    "artifactName": "SillyTavern-Setup-${version}.exe",
    "publish": {
      "provider": "github",
      "owner": "Anarrogantcat",
      "repo": "sillytavern-shell"
    },
    "directories": {
      "output": "dist-electron"
    },
    "compression": "maximum",
    "files": [
      "index.js",
      "preload.js",
      "webview-preload.cjs",
      "prompt.html",
      "prompt-preload.js",
      "shell.html",
      "shell.css",
      "shell.js",
      "i18n.js",
      "i18n-runtime.js",
      "chat.html",
      "lib/",
      "extensions/",
      "package.json",
      "assets/icon.png",
      "CHANGELOG.md"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "afterPack": "./scripts/afterPack.js",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SillyTavern",
      "include": "scripts/installer.nsh"
    }
  }
}
