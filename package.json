{
  "name": "sillytavern-electron",
  "version": "1.6.0",
  "description": "SillyTavern Desktop Shell — Electron wrapper with tray, terminal, auto-update",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "st-prep": "node scripts/prebuild.js",
    "build:full": "node -e \"['../dist-electron','../dist-electron-v3'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(_){}})\" && npm run st-prep && electron-builder --win nsis --config.directories.output='../../dist-electron-v3'",
    "build:lite": "node -e \"['../dist-electron-lite','../dist-electron-v3-lite'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(_){}})\" && electron-builder --win nsis --config electron-builder-lite.json --config.directories.output='../../dist-electron-v3-lite'",
    "build:portable": "electron-builder --win zip --config electron-builder-lite.json --config.directories.output='../../dist-electron-v3-lite'",
    "build": "npm run build:full"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "yargs": "^17.7.2"
  },
  "build": {
    "appId": "com.sillytavern.desktop",
    "productName": "SillyTavern",
    "publish": { "provider": "github", "owner": "Anarrogantcat", "repo": "sillytavern-shell" },
    "directories": {
      "output": "../../dist-electron"
    },
    "files": [
      "index.js",
      "preload.js",
      "shell.html",
      "shell.css",
      "shell.js",
      "package.json",
      "assets/icon.png",
      "CHANGELOG.md"
    ],
    "extraResources": [{ "from": "assets/icon.png", "to": "icon.png" }],
    "afterPack": "./scripts/afterPack.js",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SillyTavern",
      "include": "scripts/installer.nsh"
    }
  }
}
