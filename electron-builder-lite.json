{
  "directories": { "output": "../../dist-electron-v3-lite" },
  "appId": "com.sillytavern.desktop.lite",
  "productName": "SillyTavern",
  "publish": { "provider": "github", "owner": "Anarrogantcat", "repo": "sillytavern-shell" },
  "artifactName": "SillyTavern Lite Setup ${version}.exe",
  "files": ["index.js","preload.js","shell.html","shell.css","shell.js","package.json","assets/icon.png","CHANGELOG.md"],
  "win": { "target": "nsis", "icon": "assets/icon.png" },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SillyTavern",
    "include": "scripts/installer.nsh"
  }
}
